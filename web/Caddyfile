# Single origin for the household: portal, API, and (later) TV app and Jellyfin.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# Always the address Caddy saw, never a value the client sent (WR-02).
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Reserved: replaced by the TV app in Phase 5.
	handle /tv/* {
		respond "Not available yet" 404
	}

	# Reserved: replaced by the Jellyfin reverse proxy in Phase 3.
	handle /jellyfin/* {
		respond "Not available yet" 404
	}

	# Hashed Vite assets never change, so they are cached for a year, and only for 2xx.
	# No try_files: a missing asset must answer 404, never an HTML page cached for a year (D-42).
	handle /assets/* {
		root * /srv/portal
		header {
			match status 2xx
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}

	# index.html and the SPA fallback must be revalidated on every load, so a redeploy
	# reaches phones without clearing their cache (D-42).
	handle {
		root * /srv/portal
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
