# Single origin for the household: portal, API, Jellyfin at /jellyfin, and (later) the TV app.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	@notjellyfin not path /jellyfin /jellyfin/*

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	# The portal policy, byte for byte, scoped to everything but Jellyfin. A route-level header
	# cannot override a site-level one, so the portal policy must not apply to /jellyfin at all.
	header @notjellyfin Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

	redir /jellyfin /jellyfin/ 308

	handle /api/* {
		reverse_proxy backend:8000 {
			# Always the address Caddy saw, never a value the client sent (WR-02).
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Reserved: replaced by the TV app in Phase 5.
	handle /tv/* {
		respond "Not available yet" 404
	}

	# Jellyfin (BaseURL /jellyfin, so the path is forwarded as is: no strip_prefix). Its own
	# policy, one loosening beyond the UI-SPEC starting line:
	# 'wasm-unsafe-eval': jellyfin-web 12.3 draws ASS (libass-wasm) and PGS (libbitsub) subtitles
	# with WebAssembly; without it Chromium reports that WebAssembly compilation violates
	# script-src, which would push the server into burning subtitles in.
	# 'unsafe-inline' in style-src and script-src is the UI-SPEC starting line (upstream
	# index.html has an inline style), and it applies to /jellyfin only.
	# Accepted risk (D-04, one origin, no CORS): /jellyfin shares the portal's origin, so a script
	# injected through Jellyfin (a provider text or a file name shown in jellyfin-web) runs with
	# the portal's origin and can call /api/* with the household's session cookie. The portal
	# policy does not apply there. See "One origin for the portal and Jellyfin" in
	# docs/ports-and-media.md for the mitigations to reach for if this stops being acceptable.
	handle /jellyfin/* {
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		reverse_proxy jellyfin:8096
	}

	# Hashed Vite assets never change, so they are cached for a year, and only for 2xx.
	# No try_files: a missing asset must answer 404, never an HTML page cached for a year (D-42).
	handle /assets/* {
		root * /srv/portal
		header {
			match status 2xx
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}

	# Jellyfin stopped or unreachable: a plain sentence instead of Caddy's empty 502.
	handle_errors {
		@jellyfin_down path /jellyfin /jellyfin/*
		respond @jellyfin_down "Jellyfin is not available right now. Ask the admin to check the server." {http.error.status_code}
	}

	# index.html and the SPA fallback must be revalidated on every load, so a redeploy
	# reaches phones without clearing their cache (D-42).
	handle {
		root * /srv/portal
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
