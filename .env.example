# Flatflix configuration template. Copy to a local env file with:
#   uv run --project backend --frozen python scripts/dev_env.py
# That script fills every change-me value with a random secret. Never commit the
# generated file. Later plans append more keys to this template.

# qBittorrent (the WebUI credentials are provisioned from these at container start)
QBITTORRENT_URL=http://qbittorrent:8088
QBITTORRENT_USER=flatflix
QBITTORRENT_PASS=change-me-qbittorrent-password

# Portal login (one shared household account). There is deliberately no plaintext
# password key: APP_PASS_HASH holds an argon2id hash. Create it with
#   uv run --directory backend --frozen python -m app.tools.hash_password
# and paste the printed line, KEEPING its single quotes (Compose would otherwise
# swallow the $ signs). dev_env.py generates a dev password and hash for you.
APP_USER=famiglia
APP_PASS_HASH=change-me-run-the-hash-helper
# Signs the session cookie: at least 32 random characters. Changing it logs everyone out.
SECRET_KEY=change-me-at-least-32-random-characters
# Wrong-password limit per address, then one ceiling for all addresses together (see docs/setup.md).
LOGIN_MAX_ATTEMPTS=5
LOGIN_GLOBAL_MAX_ATTEMPTS=20
LOGIN_WINDOW_MINUTES=15
# Hosts whose X-Forwarded-For is believed (the Caddy service). Other containers are not trusted.
TRUSTED_PROXY_HOSTS=web
SESSION_MAX_AGE_DAYS=30

# Logging
LOG_LEVEL=INFO

# Compose host settings (see docs/ports-and-media.md)
WEB_PORT=80
# One host parent for media, quarantine, rejected and incomplete. It must sit on one filesystem
# on the Linux side (hardlinks), never under /mnt/c on WSL.
DATA_ROOT=./data
PUID=1000
PGID=1000
TZ=Etc/UTC
# Group id of /dev/kvm, for the sandbox container. scripts/dev_env.py fills it and
# scripts/init-host-dirs.sh checks it; `stat -c %g /dev/kvm` prints it.
KVM_GID=

# Sandbox microVM limits (D-72), read by the sandbox service.
VM_VCPUS=1
VM_MEMORY_MIB=256
VM_TIMEOUT_SECONDS=60

# qBittorrent layout (DOWN-02, DOWN-03, QUAR-01). Fixed on the server: no request can change them.
# Category names are letters and digits only. The paths are container paths under DATA_PATH, where
# docker-compose.yml binds the host folder DATA_ROOT. Downloads save into DATA_PATH/quarantine and
# reach the media folders only after the safety check; SAVE_PATH_* outside the quarantine folder
# and INCOMPLETE_PATH inside quarantine, media or rejected stop the backend at start.
CATEGORY_FILM=Film
CATEGORY_TV=SerieTV
DATA_PATH=/data
SAVE_PATH_FILM=/data/quarantine/Film
SAVE_PATH_TV=/data/quarantine/SerieTV
INCOMPLETE_PATH=/data/incomplete

# Search plugins installed on first start from the official qbittorrent/search-plugins repo,
# pinned to one reviewed commit (D-19). Space-separated names; installed ones are left alone.
SEARCH_PLUGINS=eztv limetorrents piratebay solidtorrents torlock torrentproject torrentscsv
SEARCH_PLUGINS_REF=2beb5c67b0edbf2387a031a02d1881fab4bec3c3

# Seeding policy (D-21): stop when the ratio or the time is reached, files stay in place.
SHARE_RATIO_LIMIT=1.0
SHARE_TIME_LIMIT_MINUTES=1440

# Lowest qBittorrent WebAPI version the backend accepts (qBittorrent 5.2.4 reports 2.15.1).
MIN_WEBAPI_VERSION=2.15.1

# Search (SRCH-01..03). Results with fewer seeders or a smaller size are hidden; series use the
# per-episode floor. SEARCH_TIMEOUT is in seconds. SUSPICIOUS_TERMS is comma-separated and
# empty means the built-in list. At most MAX_ACTIVE_SEARCHES run in qBittorrent at once (its
# own limit is 5); finished results stay on the server RESULT_CACHE_TTL seconds.
MIN_SEEDERS=5
MIN_FILM_SIZE_MB=500
MIN_SERIE_SIZE_MB=100
SEARCH_TIMEOUT=20
SUSPICIOUS_TERMS=
MAX_RESULTS=100
RESULT_CACHE_TTL=900
MAX_ACTIVE_SEARCHES=3

# Download pipeline (D-11, D-12). The Download request waits DOWNLOAD_WAIT_SECONDS for the outcome,
# then answers "preparing" while the backend keeps working. A torrent whose file list has not
# arrived METADATA_TIMEOUT seconds after it was added is deleted.
DOWNLOAD_WAIT_SECONDS=15
METADATA_TIMEOUT=300

# Downloads list (D-28, D-29). A finished download stays in the list COMPLETED_VISIBLE_DAYS days
# after it completed; the file stays on disk and the torrent is not touched. A failed download
# attempt stays FAILED_VISIBLE_HOURS hours.
COMPLETED_VISIBLE_DAYS=7
FAILED_VISIBLE_HOURS=24

# Rate limits (SEC-05). Starts per address per minute; only a stuck finger or a script should
# reach them. Status polling is never limited.
SEARCH_RATE_PER_MINUTE=10
DOWNLOAD_RATE_PER_MINUTE=20

# Safety check of finished downloads (Phase 2.1). A download reaches the media folders only after
# the sandbox probe accepts it.
# Where the backend reaches the sandbox service, seconds for one probe, seconds between looks at
# qBittorrent for finished torrents (D-50).
SANDBOX_URL=http://sandbox:8090
PROBE_TIMEOUT_SECONDS=90
VERIFY_POLL_SECONDS=10
# Shortest accepted film and episode, in minutes (D-64).
MIN_FILM_DURATION_MINUTES=40
MIN_EPISODE_DURATION_MINUTES=10
# Accepted average bitrate window, in kbit/s (D-65). The maximum must exceed the minimum.
MIN_BITRATE_KBPS=100
MAX_BITRATE_KBPS=100000
# Largest accepted subtitle file in MB: text formats, then bitmap formats (D-62).
SUBTITLE_TEXT_MAX_MB=5
SUBTITLE_BITMAP_MAX_MB=200
# Days a rejected download stays in the rejected folder before it is purged (D-55).
REJECTED_RETENTION_DAYS=7
# Hours a torrent may stay in "checking" before it is reported as a problem (D-78).
CHECKING_PROBLEM_HOURS=6
