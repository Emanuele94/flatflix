# Flatflix configuration template. Copy to a local env file with:
#   uv run --project backend --frozen python scripts/dev_env.py
# That script fills every change-me value with a random secret. Never commit the
# generated file. Later plans append more keys to this template.

# qBittorrent (the WebUI credentials are provisioned from these at container start)
QBITTORRENT_URL=http://qbittorrent:8088
QBITTORRENT_USER=flatflix
QBITTORRENT_PASS=change-me-qbittorrent-password

# Portal login (one shared household account). There is deliberately no plaintext
# password key: APP_PASS_HASH holds an argon2id hash. Create it with
#   uv run --directory backend --frozen python -m app.tools.hash_password
# and paste the printed line, KEEPING its single quotes (Compose would otherwise
# swallow the $ signs). dev_env.py generates a dev password and hash for you.
APP_USER=famiglia
APP_PASS_HASH=change-me-run-the-hash-helper
# Signs the session cookie: at least 32 random characters. Changing it logs everyone out.
SECRET_KEY=change-me-at-least-32-random-characters
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
SESSION_MAX_AGE_DAYS=30

# Logging
LOG_LEVEL=INFO

# Compose host settings (see docs/ports-and-media.md)
WEB_PORT=80
MEDIA_ROOT=./data/media
INCOMPLETE_DIR=./data/incomplete
PUID=1000
PGID=1000
TZ=Etc/UTC
