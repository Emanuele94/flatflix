# Flatflix configuration template. Copy to a local env file with:
#   uv run --project backend --frozen python scripts/dev_env.py
# That script fills every change-me value with a random secret. Never commit the
# generated file. Later plans append more keys to this template.

# qBittorrent (the WebUI credentials are provisioned from these at container start)
QBITTORRENT_URL=http://qbittorrent:8088
QBITTORRENT_USER=flatflix
QBITTORRENT_PASS=change-me-qbittorrent-password

# Logging
LOG_LEVEL=INFO

# Compose host settings (see docs/ports-and-media.md)
WEB_PORT=80
MEDIA_ROOT=./data/media
INCOMPLETE_DIR=./data/incomplete
PUID=1000
PGID=1000
TZ=Etc/UTC
